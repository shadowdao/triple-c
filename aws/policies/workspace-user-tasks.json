{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegisterOwnTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": [
        "arn:aws:ecs:*:*:task-definition/triple-c-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/triple-c:owner": "${aws:userid}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "triple-c:owner",
            "triple-c:project",
            "triple-c:environment"
          ]
        }
      }
    },
    {
      "Sid": "TagOwnTaskDefinitionsAtRegister",
      "Effect": "Allow",
      "Action": [
        "ecs:TagResource"
      ],
      "Resource": [
        "arn:aws:ecs:*:*:task-definition/triple-c-*"
      ],
      "Condition": {
        "StringEquals": {
          "ecs:CreateAction": "RegisterTaskDefinition",
          "aws:RequestTag/triple-c:owner": "${aws:userid}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "triple-c:owner",
            "triple-c:project",
            "triple-c:environment"
          ]
        }
      }
    },
    {
      "Sid": "ReadOwnSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:triple-c/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/triple-c:owner": "${aws:userid}"
        }
      }
    },
    {
      "Sid": "ReadFargatePrices",
      "Effect": "Allow",
      "Action": [
        "pricing:GetProducts"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "NeverReadEnvironmentSecrets",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:triple-c/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/triple-c:component": "false"
        }
      }
    },
    {
      "Sid": "RunOnlyOnOwnEc2Cluster",
      "Effect": "Deny",
      "Action": [
        "ecs:RunTask",
        "ecs:StartTask"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:*:*:cluster/triple-c-*--u-*"
        },
        "ArnNotLike": {
          "ecs:cluster": "arn:aws:ecs:*:*:cluster/triple-c-*--u-${aws:PrincipalTag/triple-c-user}"
        }
      }
    },
    {
      "Sid": "NoEc2ClusterWithoutUserTag",
      "Effect": "Deny",
      "Action": [
        "ecs:RunTask",
        "ecs:StartTask"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:*:*:cluster/triple-c-*--u-*"
        },
        "Null": {
          "aws:PrincipalTag/triple-c-user": "true"
        }
      }
    }
  ]
}
